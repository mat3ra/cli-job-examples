#!/bin/bash

# ---------------------------------------------------------------- #
#                                                                  #
#  Example job submission script for Mat3ra.com platform           #
#                                                                  #
#  Shows resource manager directives for:                          #
#                                                                  #
#    1. the name of the job                (-N)                    #
#    2. the number of nodes to be used     (-l nodes=)             #
#    3. the number of processors per node  (-l ppn=)               #
#    4. the walltime in dd:hh:mm:ss format (-l walltime=)          #
#    5. queue                              (-q) D, OR, OF, SR, SF  #
#    6. merging standard output and error  (-j oe)                 #
#    7. email about job abort, begin, end  (-m abe)                #
#    8. email address to use               (-M)                    #
#                                                                  #
#  For more info visit https://docs.mat3ra.com/jobs-cli/overview/  #
# ---------------------------------------------------------------- #

#PBS -N Q3-BANDS-TEST
#PBS -j oe
#PBS -l nodes=1
#PBS -l ppn=2
#PBS -l walltime=00:00:10:00
#PBS -q D
#PBS -m abe
#PBS -M info@mat3ra.com
#
## Uncomment the line below and put a desired project name, e.g.:
##      "seminar-default", or "john-projectname".
## NOTE: this is required when using organizational accounts.
## more at https://docs.mat3ra.com/jobs-cli/batch-scripts/directives/
## The job will be charged to the corresponding project.
## When commented out, the default project for user is assumed.
##PBS -A <PROJECT_NAME_IN_ACCOUNTING_SYSTEM>

# load default q3 module
module add q3

# go to the job working directory
cd $PBS_O_WORKDIR

# EXEC_CMD is set via `module add` above
# EXEC_CMD="apptainer exec --bind /export,/scratch,/dropbox,/cluster-001-share /export/compute/software/applications/q3/2026.10.31-0-mpi/image.sif"

# the band structure takes two runs sharing outdir and prefix:
#   1. SCF converges the charge density on a uniform k-grid and saves the effective potential
#   2. NSCF reads that potential and computes the eigenvalues along the k-point path
# the NSCF run needs one MPI rank per k-point pool, hence `--pools` equal to the rank count;
# the SCF run uses the same topology to save the checkpoint that the NSCF run reads
$EXEC_CMD mpirun -np $PBS_NP q3 --pools $PBS_NP q3_scf.yml > q3_scf.out

# keep the SCF results: the NSCF run writes to the same output/si_bands_us_results.json
cp output/si_bands_us_results.json output/si_bands_us_scf_results.json

$EXEC_CMD mpirun -np $PBS_NP q3 --pools $PBS_NP q3_bands.yml > q3_bands.out
